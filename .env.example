# Copy to .env (never commit it). All optional for local dev.
SECRET_KEY=change-me-to-a-long-random-string
DATA_DIR=./data
SECURE_COOKIES=false
EXTRACTOR=heuristic          # heuristic | openai | none
# OPENAI_API_KEY=            # optional; only used when EXTRACTOR=openai (paid, per-use)
MAX_UPLOAD_MB=10
# INBOUND_EMAIL_TOKEN=       # enables the /api/inbound-email stub
# INBOUND_EMAIL_DOMAIN=in.example.com
DEV_MODE=true                # local only: logs password-reset links (no email provider). Never in production.
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900
# TRUSTED_PROXY_HOPS=0       # 1 behind a single reverse proxy (Render)
# RESET_TOKEN_TTL_MINUTES=60
# FREE_MONTHLY_RECEIPT_LIMIT=15
